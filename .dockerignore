# Keep the build context small: the daemon only needs the dependency manifests,
# src/, and the Alembic migration tree (the image runs its own `alembic upgrade
# head` — see Dockerfile). Everything below is either rebuilt inside the image,
# host-specific, or irrelevant to the api/worker/beat runtime.
.venv
.git
.github
frontend
tests
docs
assets
**/__pycache__
*.pyc
.pytest_cache
.mypy_cache
.ruff_cache
.env
*.md
