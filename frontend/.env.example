# Origin the Vite dev server proxies /api and /ws to (see vite.config.ts).
# Defaults to the local FastAPI backend when unset.
VITE_API_PROXY_TARGET=http://localhost:8000

# Supabase project the auth flow talks to (tasks 5.11/5.12). Same project as the
# backend's SUPABASE_URL (docs/auth-setup.md). The anon key is public-by-design
# (RLS-scoped) — safe in the browser bundle; the service_role key must NEVER
# appear here or anywhere in frontend/.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
